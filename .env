APP_NAME=Dynamic AI Customer Support
ENVIRONMENT=dev
SECRET_KEY=dev-secret-key-minimum-length-32!!
API_PREFIX=/api/v1
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
RATE_LIMIT=60/minute
MAX_BODY_SIZE_BYTES=1048576
DATA_PATH=backend/app/data/training_data.txt
VECTOR_ARTIFACT_PATH=backend/app/data/vector_artifacts.json
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_ROLE=admin
LLM_BACKEND=extractive
LLM_TIMEOUT_SECONDS=20
CORS_ORIGINS=*
VECTOR_BACKEND=inmemory
